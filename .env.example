# 관리자 로그인 비밀번호 (Vercel > Settings > Environment Variables 에서 설정)
ADMIN_PASSWORD=change-me
# 세션 서명용 임의 문자열 (32자 이상 권장)
ADMIN_SECRET=change-me-to-a-long-random-string
# Vercel Blob 저장소 토큰 (Vercel > Storage > Blob 연결 시 자동 주입)
BLOB_READ_WRITE_TOKEN=
# 문의 알림 이메일(선택, Resend 사용 시)
RESEND_API_KEY=
NOTIFY_EMAIL=solkern@solkern.kr
